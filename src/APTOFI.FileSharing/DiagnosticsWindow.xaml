<Window x:Class="APTOFI.FileSharing.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APTOFI File Sharing — Diagnostics" Height="700" Width="920" MinHeight="600" MinWidth="780" WindowStartupLocation="CenterOwner" Background="#F4F5F7">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold" Text="APTOFI File Sharing Diagnostics"/>
            <TextBlock x:Name="SummaryText" Foreground="#5D6270" Margin="0,5,0,0" Text="Diagnostics have not been run yet." TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="10">
            <ListBox x:Name="ResultsList" BorderThickness="0"/>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Button x:Name="RunButton" Content="Run diagnostics" MinHeight="34" Margin="4" Padding="14,4" Click="RunButton_OnClick"/><Button x:Name="CopyButton" Content="Copy result" MinHeight="34" Margin="4" Padding="14,4" Click="CopyButton_OnClick"/></StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Content="Close" MinHeight="34" Margin="4" Padding="14,4" Click="CloseButton_OnClick"/>
        </Grid>
    </Grid>
</Window>
