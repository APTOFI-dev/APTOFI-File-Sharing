<Window x:Class="APTOFI.FileSharing.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APTOFI File Sharing — Первый запуск и настройка" Height="760" Width="960" MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F4F5F7">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8,4"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8,4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,4"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="6"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="WizardTitle" FontSize="24" FontWeight="SemiBold" Text="Первый запуск и настройка APTOFI File Sharing"/>
            <TextBlock x:Name="WizardSubtitle" Foreground="#5D6270" Margin="0,5,0,0" TextWrapping="Wrap" Text="Программа проверит хранилище, сеть, DNS, HTTPS и запуск службы. После успешной настройки мастер больше не открывается автоматически."/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                <ListBox x:Name="StepsList" BorderThickness="0" IsHitTestVisible="False" SelectedIndex="0">
                    <ListBoxItem>1. Хранилище</ListBoxItem>
                    <ListBoxItem>2. Сеть</ListBoxItem>
                    <ListBoxItem>3. Домен и HTTPS</ListBoxItem>
                    <ListBoxItem>4. Аккаунт и запуск</ListBoxItem>
                    <ListBoxItem>5. Проверка</ListBoxItem>
                </ListBox>
            </Border>
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="16">
                <TabControl x:Name="WizardTabs" BorderThickness="0" Background="Transparent" SelectedIndex="0">
                    <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                    <TabItem>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Хранилище"/>
                            <TextBlock Foreground="#5D6270" Margin="0,4,0,12" TextWrapping="Wrap" Text="Выберите основной каталог. Мастер проверит создание, чтение и удаление тестового файла."/>
                            <TextBlock FontWeight="SemiBold" Text="Каталог хранения"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StoragePathBox"/><Button x:Name="BrowseStorageButton" Grid.Column="1" Content="Выбрать" Click="BrowseStorageButton_OnClick"/></Grid>
                            <Border Background="#F5F7F8" CornerRadius="8" Padding="12" Margin="4,12,4,0"><TextBlock x:Name="StorageCheckText" Text="Проверка ещё не выполнена." TextWrapping="Wrap"/></Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Сеть"/>
                            <TextBlock Foreground="#5D6270" Margin="0,4,0,12" TextWrapping="Wrap" Text="Выберите режим публикации и порты. Для DNS-01 публичные 80/443 не требуются."/>
                            <TextBlock FontWeight="SemiBold" Text="Режим публикации"/>
                            <ComboBox x:Name="ModeBox" SelectionChanged="ModeBox_OnSelectionChanged"><ComboBoxItem Tag="Direct">Белый IP / прямой доступ</ComboBoxItem><ComboBoxItem Tag="Vps">VPS / защищённый туннель</ComboBoxItem><ComboBoxItem Tag="Local">Только локальная сеть</ComboBoxItem></ComboBox>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="Локальный IP привязки"/><TextBox x:Name="BindBox" Text="0.0.0.0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="Публичный IP"/><TextBox x:Name="PublicIpBox"/></StackPanel></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="HTTP порт"/><TextBox x:Name="HttpPortBox" Text="15745"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="HTTPS порт"/><TextBox x:Name="HttpsPortBox" Text="15746"/></StackPanel></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="Секретный путь администратора"/><TextBox x:Name="AdminPathBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="Секретный путь пользователей"/><TextBox x:Name="UserPathBox"/></StackPanel></Grid>
                            <Border x:Name="VpsPanel" Background="#F5F7F8" CornerRadius="8" Padding="10" Margin="4,8,4,4" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="VPS / защищённый туннель" Margin="4,0,4,4"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="IP / домен VPS"/><TextBox x:Name="VpsHostBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="SSH порт"/><TextBox x:Name="VpsPortBox" Text="22"/></StackPanel></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="SSH пользователь"/><TextBox x:Name="VpsUserBox" Text="root"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="SSH / sudo пароль"/><PasswordBox x:Name="VpsPasswordBox"/></StackPanel></Grid>
                                    <CheckBox x:Name="VpsSudoBox" IsChecked="True" Content="Использовать sudo для автоматической настройки VPS"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F7F8" CornerRadius="8" Padding="12" Margin="4,12,4,0"><TextBlock x:Name="NetworkCheckText" Text="Проверка ещё не выполнена." TextWrapping="Wrap"/></Border>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Домен и HTTPS"/>
                            <TextBlock Foreground="#5D6270" Margin="0,4,0,12" TextWrapping="Wrap" Text="Для автоматического HTTPS рекомендуется RFC2136/TSIG DNS-01. Проверка DNS выполняется до выпуска сертификата."/>
                            <TextBlock FontWeight="SemiBold" Text="Домен"/><TextBox x:Name="DomainBox"/>
                            <TextBlock FontWeight="SemiBold" Text="Обновление DNS"/><ComboBox x:Name="DnsModeBox" SelectionChanged="DnsModeBox_OnSelectionChanged"><ComboBoxItem Tag="Manual">Ручное / внешний DNS</ComboBoxItem><ComboBoxItem Tag="Rfc2136">RFC2136 / TSIG</ComboBoxItem></ComboBox>
                            <Border x:Name="DnsPanel" Background="#F5F7F8" CornerRadius="8" Padding="10" Margin="4,6,4,4">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="DNS сервер обновлений"/><TextBox x:Name="DnsServerBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="DNS зона"/><TextBox x:Name="DnsZoneBox"/></StackPanel></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="Имя TSIG-ключа"/><TextBox x:Name="DnsKeyBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="Алгоритм"/><ComboBox x:Name="DnsAlgorithmBox"><ComboBoxItem Tag="hmac-sha256">HMAC-SHA256</ComboBoxItem><ComboBoxItem Tag="hmac-sha512">HMAC-SHA512</ComboBoxItem><ComboBoxItem Tag="hmac-sha1">HMAC-SHA1</ComboBoxItem></ComboBox></StackPanel></Grid>
                                    <TextBlock FontWeight="SemiBold" Text="Секрет TSIG"/><PasswordBox x:Name="DnsSecretBox"/>
                                    <CheckBox x:Name="DnsAutoAddressBox" IsChecked="True" Content="Автоматически обновлять A-запись на текущий публичный IPv4"/>
                                </StackPanel>
                            </Border>
                            <TextBlock FontWeight="SemiBold" Text="Email для сертификата"/><TextBox x:Name="AcmeEmailBox"/>
                            <CheckBox x:Name="AcmeTermsBox" IsChecked="True" Content="Я принимаю условия центра сертификации для автоматического HTTPS"/>
                            <Border Background="#F5F7F8" CornerRadius="8" Padding="12" Margin="4,12,4,0"><TextBlock x:Name="DnsCheckText" Text="Проверка будет выполнена на финальном шаге." TextWrapping="Wrap"/></Border>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Аккаунт и запуск"/>
                            <TextBlock Foreground="#5D6270" Margin="0,4,0,12" TextWrapping="Wrap" Text="Создайте администратора. При повторном запуске мастера пароль можно оставить пустым, если менять его не требуется."/>
                            <TextBlock FontWeight="SemiBold" Text="Email администратора"/><TextBox x:Name="EmailBox"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="Пароль"/><PasswordBox x:Name="PasswordBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="Повторите пароль"/><PasswordBox x:Name="RepeatPasswordBox"/></StackPanel></Grid>
                            <CheckBox x:Name="TrayAutoStartBox" IsChecked="True" Content="Запускать панель APTOFI в трее после входа в Windows"/>
                            <Border Background="#F5F7F8" CornerRadius="8" Padding="12" Margin="4,12,4,0"><TextBlock x:Name="AccountCheckText" Text="После сохранения служба Windows будет установлена или перезапущена автоматически." TextWrapping="Wrap"/></Border>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Проверка конфигурации"/>
                            <TextBlock Foreground="#5D6270" Margin="0,4,0,12" TextWrapping="Wrap" Text="Нажмите «Проверить и запустить». Мастер сохранит настройки, проверит DNS/HTTPS и запустит службу."/>
                            <Border Background="#F5F7F8" CornerRadius="8" Padding="12"><TextBlock x:Name="FinalResultText" Text="Готов к проверке." TextWrapping="Wrap"/></Border>
                            <ProgressBar x:Name="FinalProgress" Height="12" Margin="4,16,4,0" Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="Закрыть" HorizontalAlignment="Left" Click="CancelButton_OnClick"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Назад" Click="BackButton_OnClick"/><Button x:Name="NextButton" Content="Далее" Background="#FFD33D" FontWeight="SemiBold" Click="NextButton_OnClick"/></StackPanel>
        </Grid>
    </Grid>
</Window>
